  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:connection": "node --env-file=.env --import tsx src/tests/test-connection.ts",
    "test:neo4j": "node --env-file=.env --import tsx src/tests/neo4jMemoryStore-test.ts",
    "test:intent": "node --import tsx src/tests/intent-engine-test.ts && node --import tsx src/tests/intent-agent-wiring-test.ts",
    "test:planner": "node --import tsx src/tests/planning-engine-test.ts",
    "test:mcp": "node --import tsx src/tests/mcp-tool-e2e-test.ts",
    "test:action": "node --import tsx src/tests/action-engine-test.ts",
    "test:planner-actions": "node --import tsx src/tests/planner-action-aware-test.ts",
    "test:pipeline": "node --import tsx src/tests/action-pipeline-test.ts",
    "test:execution": "node --import tsx src/tests/execution-result-test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "gitignore": "^0.7.0",
    "neo4j-driver": "^6.2.0",
    "openai": "^7.4.0"
  }
}
